# ─── App ────────────────────────────────────────────────────────────────
# Public base URL (used in invitation links, emails, Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (EU / Frankfurt project) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — used for Storage uploads/signed URLs. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (Prisma 7 + @prisma/adapter-pg) ───────────────────────────
# Runtime: pooled connection (Supavisor transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# CLI (migrate): direct / session connection (port 5432)
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ─── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Mi Comunidad <avisos@micomunidad.app>"

# ─── Storage ────────────────────────────────────────────────────────────
# Private Supabase Storage bucket (created automatically on first upload)
SUPABASE_STORAGE_BUCKET=comunidad-files
